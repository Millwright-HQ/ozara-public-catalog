# Full URL of GET /v1/catalog/public-catalog on the OZARA API (server-side only).
CATALOG_API_URL=
# Shared secret; must equal the API's SSM parameter /aussie/<stage>/config/public-catalog-key (server-side only).
CATALOG_API_KEY=
# Image CDN root, same value as the main website's NEXT_PUBLIC_CDN_URL. Images are <cdn>/<base>/<width>.webp.
NEXT_PUBLIC_CDN_URL=
# Set to 1 to show fake sample products instead of calling the API.
CATALOG_DEMO=
